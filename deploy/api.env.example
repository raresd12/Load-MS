# /etc/loadms/api.env (root:loadms, mode 0640). Example values only: no real
# secret is ever committed. Generate the invite code on the server, e.g.
#   openssl rand -base64 18
LOADMS_PORT=3100
LOADMS_HOST=127.0.0.1
LOADMS_DB=/opt/loadms/data/loadms.db
# Comma list of exact origins (scheme://host[:port], no trailing slash): the
# Netlify site that serves the app. Confirm the current site name first.
LOADMS_ALLOWED_ORIGINS=https://sunny-marshmallow-bb5e55.netlify.app
LOADMS_SIGNUP_CODE=replace-with-a-long-random-invite-code
LOADMS_MAX_ACCOUNTS=50
# Caddy sets X-Forwarded-For; the API keys its per-IP limits on it.
LOADMS_TRUST_PROXY=1
